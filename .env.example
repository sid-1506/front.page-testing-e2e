# Copy to .env (gitignored). Never commit real values.

# front.page login is phone number + OTP behind reCAPTCHA, so these two are NOT used to log in.
# Authenticate once with:  npm run auth:login   (headed browser, saves playwright/.auth/user.json)
# They are still read so the report can be checked for leaks: if TEST_PASSWORD is set,
# the build fails when its literal value appears anywhere in the report.
TEST_EMAIL=
TEST_PASSWORD=

# Extra literal strings to scrub from everything stored or shown (comma-separated),
# e.g. the test account's phone number or handle. The display name is detected automatically.
REDACT_TERMS=

BASE_URL=https://front.page

# Where the tests run from. Indian locations reflect real users best.
TEST_LOCATION=Bengaluru, IN

# Measured repetitions per workflow per profile (one extra unmeasured warm-up run is always added).
RUNS=3
